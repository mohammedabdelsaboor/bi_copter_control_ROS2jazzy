    <!-- ==================== Primary Central Launch & Landing Pad A (Centered at 0, 0) ==================== -->
    <model name="primary_helipad_a">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="pad_col">
          <geometry><cylinder><radius>1.2</radius><length>0.01</length></cylinder></geometry>
        </collision>

        <!-- Base Platform -->
        <visual name="base_plate">
          <geometry><cylinder><radius>1.2</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.12 0.14 0.16 1</diffuse></material>
        </visual>

        <!-- Outer Precision Ring (Cyan) -->
        <visual name="outer_cyan_ring">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><cylinder><radius>1.14</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0 0.75 0.95 1</ambient><diffuse>0 0.75 0.95 1</diffuse></material>
        </visual>

        <!-- Intermediate Dark Ring -->
        <visual name="mid_dark_ring">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry><cylinder><radius>1.02</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.12 0.14 0.16 1</diffuse></material>
        </visual>

        <!-- Inner Touchdown Ring (White) -->
        <visual name="inner_white_ring">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry><cylinder><radius>0.88</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>

        <!-- Center Deck Platform -->
        <visual name="center_deck">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry><cylinder><radius>0.80</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.15 0.17 0.20 1</ambient><diffuse>0.15 0.17 0.20 1</diffuse></material>
        </visual>

        <!-- Optical Crosshair Calibration Reticle -->
        <visual name="crosshair_x"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>1.8 0.035 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="crosshair_y"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.035 1.8 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>

        <!-- Bold Yellow "H" Marking -->
        <visual name="h_bar_l"><pose>0 0.26 0.006 0 0 0</pose><geometry><box><size>0.70 0.11 0.01</size></box></geometry><material><ambient>1 0.85 0 1</ambient><diffuse>1 0.85 0 1</diffuse></material></visual>
        <visual name="h_bar_r"><pose>0 -0.26 0.006 0 0 0</pose><geometry><box><size>0.70 0.11 0.01</size></box></geometry><material><ambient>1 0.85 0 1</ambient><diffuse>1 0.85 0 1</diffuse></material></visual>
        <visual name="h_cross"><pose>0 0 0.006 0 0 0</pose><geometry><box><size>0.11 0.52 0.01</size></box></geometry><material><ambient>1 0.85 0 1</ambient><diffuse>1 0.85 0 1</diffuse></material></visual>

        <!-- North Alignment Arrow (Safety Orange) -->
        <visual name="arrow_stem"><pose>0.96 0 0.006 0 0 0</pose><geometry><box><size>0.26 0.07 0.01</size></box></geometry><material><ambient>0.95 0.4 0 1</ambient><diffuse>0.95 0.4 0 1</diffuse></material></visual>
        <visual name="arrow_head"><pose>1.08 0 0.006 0 0 0.785</pose><geometry><box><size>0.14 0.14 0.01</size></box></geometry><material><ambient>0.95 0.4 0 1</ambient><diffuse>0.95 0.4 0 1</diffuse></material></visual>

