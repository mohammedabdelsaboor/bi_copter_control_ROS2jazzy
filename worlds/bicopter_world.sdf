        <!-- Emergency Stop Pedestal -->
        <collision name="estop_col"><pose>-2.7 0 0.5 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="estop_ped"><pose>-2.7 0 0.5 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>1.0</length></cylinder></geometry><material><ambient>0.95 0.8 0 1</ambient><diffuse>0.95 0.8 0 1</diffuse></material></visual>
        <visual name="estop_btn"><pose>-2.7 0 1.03 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse><emissive>0.7 0.05 0.05 1</emissive></material></visual>
      </link>
    </model>

    <!-- ==================== The Bi-Copter Drone Model (Spawns on Central Pad) ==================== -->
    <include>
      <uri>model://bi_copter</uri>
      <name>bi_copter</name>
      <pose>0 0 0.045 0 0 0</pose>
    </include>

  </world>
</sdf>
